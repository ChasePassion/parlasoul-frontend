# Better Auth
DATABASE_URL=postgresql://role_play_user:<db_password>@localhost:5432/role_play_mem
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=<replace-with-openssl-rand-base64-32>
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_MEDIA_BASE_URL=/media
INTERNAL_BACKEND_BASE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6380/0
OTP_DELIVERY_STATUS_TTL_SECONDS=600
OTP_DELIVERY_STATUS_KEY_PREFIX=parlasoul:auth:email-otp:status

# Dodo Payments
DODO_PAYMENTS_API_KEY=<dodo_payments_api_key>
DODO_PAYMENTS_WEBHOOK_SECRET=<dodo_payments_webhook_secret>
DODO_PAYMENTS_ENVIRONMENT=test_mode
BILLING_PAYWALL_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
NEXT_PUBLIC_BILLING_PAYWALL_ENABLED=false
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=false

# Email OTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=<qq_mail_address>
SMTP_PASSWORD=<qq_mail_authorization_code>
EMAILS_FROM_EMAIL=ParlaSoul <<qq_mail_address>>

# Google 登录已撤销；恢复时取消下面两行注释。
# GOOGLE_CLIENT_ID=<google_client_id>
# GOOGLE_CLIENT_SECRET=<google_client_secret>
